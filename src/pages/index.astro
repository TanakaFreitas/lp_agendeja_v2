---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Dores from '../components/Dores.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ParaCliente from '../components/ParaCliente.astro';
import ParaBarbearia from '../components/ParaBarbearia.astro';
import PlanosAssinatura from '../components/PlanosAssinatura.astro';
import Precos from '../components/Precos.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import { DIAS_TESTE } from '../data/planos';

const title = 'Agende Já — agendamento online para barbearias';
const description = `Seu cliente agenda sozinho pelo link da barbearia e recebe confirmação e lembrete no WhatsApp. Agenda, profissionais, planos de assinatura e recebimentos num lugar só. Teste grátis por ${DIAS_TESTE} dias, sem cartão.`;
---

<Base title={title} description={description}>
  <Header />
  <main id="conteudo">
    <Hero />
    <Dores />
    <ComoFunciona />
    <ParaCliente />
    <ParaBarbearia />
    <PlanosAssinatura />
    <Precos />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
</Base>
