---
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { faq } from '../data/faq';
import { whatsapp } from '../data/links';
---

<section class="section" id="duvidas" aria-labelledby="faq-title">
  <div class="container narrow">
    <div class="section-head section-head--center">
      <span class="eyebrow">Dúvidas</span>
      <h2 id="faq-title" class="section-title">Perguntas frequentes</h2>
    </div>

    <div class="list">
      {
        faq.map((f) => (
          <details class="item">
            <summary>
              <span>{f.pergunta}</span>
              <Icon name="chevronDown" class="chev" />
            </summary>
            <p>{f.resposta}</p>
          </details>
        ))
      }
    </div>

    <p class="mais">
      Ficou alguma dúvida?
      <a class="text-link" href={whatsapp('Olá! Vim pelo site e tenho uma dúvida sobre o Agende Já.')} target="_blank" rel="noopener">
        <WhatsAppIcon size={18} />
        Pergunte pelo WhatsApp
      </a>
    </p>
  </div>
</section>

<style>
  .narrow {
    max-width: 52rem;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }

  .item {
    border: 1px solid var(--border);
    border-radius: var(--r-16);
    background: var(--surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-16);
    min-height: 56px;
    padding: var(--s-16) var(--s-24);
    font-family: var(--font-title);
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(.chev) {
    flex: none;
    transition: transform 0.2s ease;
  }

  .item[open] summary :global(.chev) {
    transform: rotate(180deg);
  }

  .item p {
    max-width: 65ch;
    padding: 0 var(--s-24) var(--s-24);
    color: var(--text-muted);
  }

  .mais {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-4) var(--s-12);
    margin-top: var(--s-32);
    color: var(--text-muted);
  }

  .mais .text-link {
    gap: var(--s-8);
  }
</style>
