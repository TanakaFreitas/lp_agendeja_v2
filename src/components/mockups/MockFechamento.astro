---
import './mockup.css';
import Icon from '../Icon.astro';

interface Props {
  class?: string;
}
---

<div
  class:list={['phone', Astro.props.class]}
  role="img"
  aria-label="Exemplo ilustrativo de conversa no WhatsApp: no domingo chegam duas mensagens, o fechamento da semana com os números da barbearia e, logo em seguida, uma análise escrita por IA."
>
  <div class="m-screen">
    <div class="m-appbar">
      <Icon name="chevronRight" class="flip" />
      <span class="m-avatar">AJ</span>
      <span class="m-appbar-title">Agende Já</span>
    </div>
    <div class="m-body thread">
      <span class="stamp">Domingo</span>
      <div class="bubble">
        <span class="m-strong" style="display:block">Fechamento da semana</span>
        <span class="m-small m-muted" style="display:block">18/10 a 24/10 · Barbearia do Zé</span>
        <span class="detail">
          <span><b>Recebido</b><i>R$ 1.670,00</i></span>
          <span><b>Pendências</b><i>R$ 0,00</i></span>
          <span><b>Ticket médio</b><i>R$ 50,61</i></span>
          <span><b>Serviços realizados</b><i>33</i></span>
          <span><b>Cancelamentos</b><i>5</i></span>
          <span><b>Horários vagos efetivos</b><i>0</i></span>
        </span>
        <span class="time">09:00</span>
      </div>
      <div class="bubble">
        <span class="m-chip" style="margin-bottom: 6px">Análise escrita por IA</span>
        <span class="m-strong" style="display:block">Diagnóstico rápido</span>
        Semana forte: a agenda foi disputada e os 5 cancelamentos foram preenchidos por encaixes.
        <span class="m-strong" style="display:block; margin-top: 8px">Foco para segunda-feira</span>
        Chame os clientes recorrentes para um horário de início de semana.
        <span class="time">09:01</span>
      </div>
    </div>
  </div>
</div>

<style>
  .flip {
    transform: scaleX(-1);
  }

  .thread {
    gap: 10px;
    background:
      radial-gradient(circle, var(--primary-tint) 0 1.5px, transparent 2px) 0 0 / 18px 18px,
      var(--bg);
  }

  .stamp {
    align-self: center;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 10.5px;
    font-weight: 600;
    box-shadow: var(--shadow);
  }

  .bubble {
    position: relative;
    max-width: 94%;
    padding: 10px 12px 20px;
    border-radius: 4px 12px 12px 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 8px;
    padding: 8px;
    border-radius: 6px;
    background: var(--primary-tint);
  }

  .detail > span {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .detail b {
    font-weight: 500;
  }

  .detail i {
    font-style: normal;
    font-weight: 700;
    white-space: nowrap;
  }

  .time {
    position: absolute;
    right: 10px;
    bottom: 4px;
    font-size: 10px;
    color: var(--text-muted);
  }
</style>
