---
// Logo sobre disco claro: a ilustração é preta sobre transparente e não deve ser invertida no escuro.
import { Image } from 'astro:assets';
import logo from '../assets/Logo1.png';

interface Props {
  size?: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  /** Vazio quando o nome "Agende Já" já aparece em texto ao lado. */
  alt?: string;
}

const { size = 44, class: className, loading = 'eager', alt = 'Agende Já' } = Astro.props;
---

<span class:list={['logo-disc', className]} style={`--size: ${size}px`}>
  <Image
    src={logo}
    alt={alt}
    width={size * 2}
    height={size * 2}
    densities={[1]}
    format="webp"
    loading={loading}
    decoding="async"
  />
</span>

<style>
  .logo-disc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: var(--r-pill);
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
    overflow: hidden;
  }

  .logo-disc img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
